# Copy to .env and fill in. .env is gitignored; this file is not.

# Gonka Router — the risk model. Without it the gate abstains, which escalates.
GONKA_API_KEY=sk-...

# Seals the platform signing key at rest. 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WALLET_MASTER_KEY=

# Shared passphrase for POST /api/onboard. Unset means onboarding is CLOSED, not open.
ONBOARD_PASS=demo

# Your own funded testnet wallet, used only by `npm run fund` to top up agent
# wallets. Sui bech32 secret key (suiprivkey1...). Never read by the server.
PRIVATE_KEY=

# Shinami Gas Station (testnet). Sponsors gas so the agent wallet needs no SUI for fees.
SHINAMI_GAS_STATION_ACCESS_KEY=
SHINAMI_NODE_ACCESS_KEY=

# Optional: the public origin, used to build the setup URL.
# PUBLIC_BASE_URL=https://your-host
